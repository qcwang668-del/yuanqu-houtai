# 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# 项目名称
PROJECT_NAME=智远力企-saas

# 开发环境
NODE_ENV=development

# API 地址
API_BASE_URL=http://127.0.0.1:3000

# 数据库配置（本地/生产双库，见 CLAUDE.md §10）
# 本地开发经 SSH 隧道（scripts/db-tunnel.sh）连远程库：连本机隧道端口
DB_HOST_LOCAL=127.0.0.1
DB_PORT_LOCAL=19193
# 生产库：直连、不走隧道
DB_HOST_PROD=106.53.136.31
DB_PORT_PROD=3307
DB_NAME=智远力企-saas
DB_USER=your_user
DB_PASSWORD=your_password
# 唯一真相源：local / prod（部署前须核对两处数据一致）
DB_SOURCE_OF_TRUTH=prod

# 钉钉通知 webhook（通用通知群；本项目多群绑定见 CLAUDE.md §5）
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=d1517701b4a656a8243869fed8da9ab36763ae56fd7091dbb1fbb173807a2f9b

# 钉钉机器人管理后台（入站路由 + 出站推送，见 CLAUDE.md §5）
ROBOT_ADMIN_URL=http://127.0.0.1:19160
# 应用机器人主动群发凭据（放这里，禁止硬编码进代码/仓库）
DING_APPKEY=
DING_APPSECRET=

# 文件上传服务器
FILE_UPLOAD_URL=http://106.53.136.31:19000/api/files/upload/

# 内网穿透稳定域名（cpolar，见 CLAUDE.md §9）；对外链接统一用它，勿硬编码临时 IP
MEDIA_BASE=https://<固定前缀>.cpolar.top

# 健康检查 / 看门狗（见 CLAUDE.md §7）
HEALTHZ_URL=http://127.0.0.1:8000/healthz

# 浏览器自动化
BROWSER_HEADLESS=1

# 日志级别
LOG_LEVEL=info

# ── 后端 Spring Boot 数据源（application.yml 读取，二选一：本地或经隧道映射后的端口）──
DB_HOST=127.0.0.1
DB_PORT=3306
# DB_NAME / DB_USER / DB_PASSWORD 复用上方定义

# ── 企业数据平台（qiyedata）企业基本信息接口（仅授权本项目使用，禁止外泄/代理给外部项目）──
QIYEDATA_BASE_URL=
QIYEDATA_APP_KEY=
QIYEDATA_APP_SECRET=
# 可选：请求头 tenant-id
QIYEDATA_TENANT_ID=
