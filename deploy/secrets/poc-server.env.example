# 启程智远 · PoC 服务器 + 私有化卫星服务 · 访问凭据（示例模板）
# 复制为 deploy/secrets/poc-server.env 并填入真实值（真实文件已被 .gitignore 忽略）。
# 同目录还应放本项目专用私钥 id_poc_ed25519（同样被忽略）。

########## 一、PoC 服务器（SSH） ##########
POC_HOST=<公网IP>
POC_SSH_PORT=22
POC_SSH_USER=root
POC_SSH_PASSWORD=<后备密码，可留空只用密钥>
POC_SSH_KEY=deploy/secrets/id_poc_ed25519
POC_STACK_DIR=/opt/qczy-poc

########## 二、MySQL 8.0 ##########
MYSQL_HOST=<公网IP>
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=oa_hrm
MYSQL_USER=hrm
MYSQL_PASSWORD=change_me_hrm

########## 三、Redis 7 ##########
REDIS_HOST=<公网IP>
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis

########## 四、MinIO 对象存储 ##########
MINIO_ENDPOINT=http://<公网IP>:9000
MINIO_CONSOLE=http://<公网IP>:9001
MINIO_ROOT_USER=poc_admin
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_DEFAULT_BUCKET=liqi-attachments
AWS_ACCESS_KEY_ID=poc_admin
AWS_SECRET_ACCESS_KEY=change_me_minio
AWS_S3_ENDPOINT=http://<公网IP>:9000
AWS_DEFAULT_REGION=us-east-1

########## 五、Nginx 网关 ##########
GATEWAY_URL=http://<公网IP>
